<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackgroundDark">

    <!-- Background Glow -->
    <org.example.kinetiqfun.SnowBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Logo Game -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:src="@drawable/game_logo"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toTopOf="@+id/txtLoading"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Teks Loading -->
    <TextView
        android:id="@+id/txtLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="LOADING SYSTEM..."
        android:textColor="@color/colorPrimary"
        android:textSize="22sp"
        android:fontFamily="@font/game_font"
        android:letterSpacing="0.1"
        android:shadowColor="@color/colorPrimary"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="10"
        app:layout_constraintBottom_toTopOf="@+id/progressBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <!-- Game Tips -->
    <TextView
        android:id="@+id/txtTips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="80dp"
        android:layout_marginEnd="80dp"
        android:gravity="center"
        android:text="Tip: Keep your body within the camera frame for accurate tracking."
        android:textColor="@color/textColorSecondary"
        android:textSize="16sp"
        android:fontStyle="italic"
        app:layout_constraintTop_toBottomOf="@+id/progressBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Loading Bar Background (Dashed/Empty) -->
    <View
        android:id="@+id/progressBarBg"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginStart="80dp"
        android:layout_marginEnd="80dp"
        android:layout_marginBottom="60dp"
        android:background="@drawable/loading_bar_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Loading Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:minHeight="16dp"
        android:maxHeight="16dp"
        android:progressDrawable="@drawable/custom_progress_bar"
        android:indeterminate="false"
        android:progress="0"
        android:max="100"
        app:layout_constraintTop_toTopOf="@id/progressBarBg"
        app:layout_constraintBottom_toBottomOf="@id/progressBarBg"
        app:layout_constraintStart_toStartOf="@id/progressBarBg"
        app:layout_constraintEnd_toEndOf="@id/progressBarBg" />

    <!-- Angka Persentase (Moved below progressBar to be on top) -->
    <TextView
        android:id="@+id/txtPercentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0%"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:fontFamily="@font/game_font"
        android:shadowColor="@android:color/black"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="4"
        android:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/progressBar"
        app:layout_constraintEnd_toEndOf="@+id/progressBar"
        app:layout_constraintStart_toStartOf="@+id/progressBar"
        app:layout_constraintTop_toTopOf="@+id/progressBar" />

    <!-- Start Button (Muncul setelah Loading Selesai) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStart"
        style="@style/Widget.KinetiQFun.Button.Outline"
        android:layout_width="240dp"
        android:layout_height="64dp"
        android:layout_marginBottom="50dp"
        android:text="START"
        android:textSize="24sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>