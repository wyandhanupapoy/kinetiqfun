<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main Application Theme -->
    <style name="Theme.KinetiQFun" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/colorBackgroundDark</item>
        <item name="android:textColorPrimary">@color/textColorPrimary</item>
        <item name="android:textColorSecondary">@color/textColorSecondary</item>
        <item name="android:fontFamily">@font/game_font</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.KinetiQFun">
        <item name="android:windowBackground">@android:color/black</item>

        <!-- Menangani Android 12+ Splash Screen -->
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>

        <!-- Menghilangkan 'Starting Window' agar langsung masuk ke activity -->
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>